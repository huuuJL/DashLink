<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>DashLink</string>
	<key>CFBundleDisplayName</key>
	<string>DashLink</string>
	<key>CFBundleIdentifier</key>
	<string>local.dashlink.mac</string>
	<key>CFBundleExecutable</key>
	<string>DashLink</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.2.0</string>
	<key>CFBundleVersion</key>
	<string>17</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>DashLink uses Bluetooth to discover and pair the iPhone you select for wireless CarPlay.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>DashLink connects to your selected iPhone to start wireless CarPlay.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>DashLink receives CarPlay video and audio from your iPhone over your local Wi-Fi network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>DashLink can send microphone audio to your iPhone for Siri and phone calls when you allow it.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_airplay._tcp</string>
		<string>_raop._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
</dict>
</plist>
